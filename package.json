{
  "name": "tokenpenny",
  "version": "0.4.0",
  "description": "See where your AI coding agents' tokens and dollars actually go — one command, every agent, task-level attribution. 看清你的 AI 编程 Agent 把 token 和钱花在了哪里。",
  "type": "module",
  "bin": {
    "tokenpenny": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
